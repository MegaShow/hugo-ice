{
  "name": "hugo-ice",
  "description": "A hugo theme designed by MegaShow.",
  "main": "assets/js/main.ts",
  "type": "module",
  "author": "MegaShow",
  "license": "MIT",
  "scripts": {
    "build": "hugo --minify --source exampleSite --themesDir ../..",
    "build:docs": "hugo --minify --source docs --themesDir ../..",
    "dev": "hugo serve --minify --source exampleSite --themesDir ../.. --port 8080",
    "dev:docs": "hugo serve --minify --source docs --themesDir ../.. --port 8080",
    "ts-check": "tsc --noEmit",
    "eslint": "eslint assets/js/ --fix --cache --quiet --ext .ts",
    "stylelint": "stylelint assets/css/**/*.scss --fix --cache --quiet"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^17.7.0",
    "prettier": "^3.9.6",
    "prettier-plugin-go-template": "^0.0.15",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0"
  },
  "packageManager": "pnpm@11.17.0+sha512.cca3cea332ad254bb84145f966d19f4879615210346fc92c79a047f23a0d7b3cca3c3792f0076ba1f1831d277efbcf0a9119b31a9a60eca7fb3d6231f331ef72"
}
